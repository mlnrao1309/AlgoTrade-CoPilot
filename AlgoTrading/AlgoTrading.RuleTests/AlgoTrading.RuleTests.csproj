<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures\*.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="database-test.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AlgoTrading.DataAccess\AlgoTrading.DataAccess.csproj" />
  </ItemGroup>
</Project>
