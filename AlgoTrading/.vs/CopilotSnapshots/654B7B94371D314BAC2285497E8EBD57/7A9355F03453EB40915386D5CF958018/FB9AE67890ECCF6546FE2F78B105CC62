using System;
using System.ComponentModel;
using System.Text;
using System.Threading.Tasks;
using System.Windows;
using System.Windows.Controls;
using System.Windows.Data;
using System.Windows.Documents;
using System.Windows.Input;
using System.Windows.Media;
using System.Windows.Media.Imaging;
using System.Windows.Navigation;
using System.Windows.Shapes;
using Microsoft.Web.WebView2.Core;
using Microsoft.Web.WebView2.Wpf;

namespace AlgoTrading
{
    /// <summary>
    /// Interaction logic for MainWindow.xaml
    /// </summary>
    public partial class MainWindow : Window
    {
        public MainWindow()
        {
            InitializeComponent();
            var vm = new ViewModels.WebViewViewModel();
            DataContext = vm;

            // Ensure WebView2 is initialized on load and navigate
            this.Loaded += async (s, e) =>
            {
                await EnsureCoreWebView2Async();

                // Attach WebResourceResponseReceived handler to forward events to ViewModel
                try
                {
                    if (WebView2Control.CoreWebView2 != null)
                    {
                        WebView2Control.CoreWebView2.WebResourceResponseReceived += vm.OnWebResourceResponseReceived;
                    }
                }
                catch { }

                if (!string.IsNullOrEmpty(vm.Uri))
                {
                    try
                    {
                        WebView2Control.CoreWebView2?.Navigate(vm.Uri);
                        WebView2Control.Source = new Uri(vm.Uri);
                    }
                    catch { }
                }
            };

            // Navigate when the ViewModel Uri changes
            vm.PropertyChanged += async (s, e) =>
            {
                if (e.PropertyName == nameof(ViewModels.WebViewViewModel.Uri))
                {
                    if (!string.IsNullOrEmpty(vm.Uri))
                    {
                        try
                        {
                            await EnsureCoreWebView2Async();
                            if (WebView2Control.CoreWebView2 != null)
                                WebView2Control.CoreWebView2.Navigate(vm.Uri);
                            else
                                WebView2Control.Source = new Uri(vm.Uri);
                        }
                        catch { }
                    }
                }
            };
        }

        private async Task EnsureCoreWebView2Async()
        {
            try
            {
                if (WebView2Control.CoreWebView2 == null)
                {
                    await WebView2Control.EnsureCoreWebView2Async(null);
                }
            }
            catch
            {
                // ignore initialization errors for now
            }
        }
    }
}