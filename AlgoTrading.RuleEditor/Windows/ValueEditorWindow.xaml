<Window x:Class="AlgoTrading.RuleEditor.Windows.ValueEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14"
        Title="Edit rule value" Width="720" Height="780" MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Choose a value" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Use a candle field, indicator or calculation. Sources can contain other indicators." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,18" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FieldsPanel" Margin="0,0,12,12" />
        </ScrollViewer>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#FCA5A5" Margin="0,10,0,10" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0" />
            <Button Content="Apply value" Click="OnApply" Style="{StaticResource PrimaryButton}" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>

