<Window x:Class="AlgoTrading.RuleEditor.Windows.ConditionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14"
        Title="Edit counted conditions" Width="1060" Height="760" MinWidth="900" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Which candles should count?" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentControl x:Name="EditorHost" Margin="0,0,12,0" /></ScrollViewer>
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#FCA5A5" Margin="0,10,0,10" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0" />
            <Button Content="Apply conditions" Click="OnApply" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>

