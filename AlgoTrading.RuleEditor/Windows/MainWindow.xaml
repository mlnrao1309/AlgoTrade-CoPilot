<Window x:Class="AlgoTrading.RuleEditor.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="14"
        Title="AlgoTrading · Rule Editor" Width="1440" Height="930" MinWidth="1150" MinHeight="650"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="26,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="New" Click="OnNew" Margin="0,0,8,0" />
                    <Button Content="Open rule" Click="OnOpen" Margin="0,0,8,0" />
                    <Button Content="Validate" Click="OnValidate" Margin="0,0,8,0" />
                    <Button Content="Save rule" Click="OnSave" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#6D45C1" Width="32" Height="32" CornerRadius="7" Margin="0,0,12,0"><TextBlock Text="A" FontWeight="Bold" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="ALGOTRADING" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text=" /  Rule editor" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="26,24,26,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0">
                <TextBlock Text="Strategy name" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
                <TextBox x:Name="NameBox" FontSize="20" FontWeight="SemiBold" LostKeyboardFocus="OnNameChanged" AutomationProperties.Name="Strategy name" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,20,0">
                <TextBlock Text="Evaluate on each completed" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7" />
                <ContentControl x:Name="TimeframeHost" />
            </StackPanel>
            <Border Grid.Column="2" Background="#122A2A" BorderBrush="#24504C" BorderThickness="1" CornerRadius="8" Padding="14" VerticalAlignment="Bottom">
                <StackPanel><TextBlock Text="●  Completed candles only" Foreground="#8EE1C2" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="No forming-candle signals" Foreground="#9BBFB5" FontSize="11" Margin="0,4,0,0" /></StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="26,0,26,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,22,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="UndoButton" Content="Undo" Click="OnUndo" Margin="0,0,6,0" Padding="10,5" />
                        <Button x:Name="RedoButton" Content="Redo" Click="OnRedo" Padding="10,5" />
                    </StackPanel>
                    <TextBlock Text="Conditions" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer x:Name="RuleScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="EditorHost" Margin="0,0,12,0" />
                </ScrollViewer>
            </Grid>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="RULE CHECK" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock x:Name="ValidationTitle" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,8" />
                        <TextBlock x:Name="ValidationMessage" FontSize="13" Margin="0,0,0,20" />
                        <Border Background="{StaticResource LineBrush}" Height="1" Margin="0,0,0,18" />
                        <TextBlock Text="Timeframes used" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="TimeframesText" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,6,0,20" />
                        <TextBlock Text="Read your rule" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="PreviewText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,20" />
                        <Border Background="{StaticResource LineBrush}" Height="1" Margin="0,0,0,18" />
                        <TextBlock Text="Building a nested calculation" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Select a value, choose Indicator, then edit its Source to use another indicator or calculation." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,16" />
                        <TextBlock Text="Crossovers compare both the previous and current completed candle. Different timeframes align by their closing timestamps." Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="#101827" Padding="26,10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button Content="Load breakout example" Click="OnLoadExample" DockPanel.Dock="Right" Padding="8,4" FontSize="12" />
                <TextBlock x:Name="StatusText" Text="Unsaved example · Select any value to edit it." Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>

